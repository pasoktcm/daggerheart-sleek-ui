<div class="card-wrapper party-character">

  {{#if @root.showStats}}
  <div class="party-character-overlay">

        {{!-- EVASION --}}
    <div class="values-container evasion">
      <span class="value-number">{{evasion}}</span>
      <h3 class="label-hidden">{{localize "DAGGERHEART.GENERAL.evasion"}}</h3>
    </div>

    {{!-- THRESHOLDS --}}
    <div class="values-container thresholds">

      <h3 class="threshold-damage" data-action="modifyResource" data-actor-uuid="{{actorUuid}}"
        data-resource="hitPoints.value" data-amount="1">
        {{localize "DAGGERHEART.ACTORS.Party.Thresholds.minor"}}
      </h3>

      <span class="value-number">{{damageThresholds.major}}</span>

      <h3 class="threshold-damage" data-action="modifyResource" data-actor-uuid="{{actorUuid}}"
        data-resource="hitPoints.value" data-amount="2">
        {{localize "DAGGERHEART.ACTORS.Party.Thresholds.major"}}
      </h3>

      <span class="value-number">{{damageThresholds.severe}}</span>

      <h3 class="threshold-damage" data-action="modifyResource" data-actor-uuid="{{actorUuid}}"
        data-resource="hitPoints.value" data-amount="3">
        {{localize "DAGGERHEART.ACTORS.Party.Thresholds.severe"}}
      </h3>

    </div>

    {{#if (or primaryWeapon secondaryWeapon)}}
    <div class="equipment-container">
      {{#if primaryWeapon}}
      <div class="equipment-icon primary">
        <img src="{{primaryWeapon.img}}" alt="{{primaryWeapon.name}}" data-tooltip="{{primaryWeapon.name}}">
      </div>
      {{/if}}

      {{#if secondaryWeapon}}
      <div class="equipment-icon secondary">
        <img src="{{secondaryWeapon.img}}" alt="{{secondaryWeapon.name}}" data-tooltip="{{secondaryWeapon.name}}">
      </div>
      {{/if}}
    </div>
    {{/if}}
  </div>
  {{/if}}

  <div class="party-character-icon" data-action="openMemberSheet" data-actor-uuid="{{actorUuid}}" style="cursor:pointer">

    <img class="icon" src="{{actor.img}}" />

  </div>

  <div class="character-information">

    <div class="hope-row">

      {{!-- NAME --}}
      <h1 class="small">{{actor.name}}</h1>

      {{!-- HOPE --}}
      {{#if @root.showStats}}
      <div class="hope-container">

        <span class="hope-bar">
          {{#times hope.max}}
          <span class='hope-value' data-action='toggleHope' data-actor-uuid="{{../actorUuid}}"
            data-value="{{add this 1}}">
            {{#if (gte ../hope.value (add this 1))}}
            <div class="hope-icon-full"></div>
            {{else}}
            <div class="hope-icon-empty"></div>
            {{/if}}
          </span>
          {{/times}}
        </span>

      </div>
      {{/if}}

    </div>

    {{#if @root.showStats}}
    <div class="resources-traits-row">

      <div class="resources-row">
              
        {{!-- HIT POINTS --}}
        {{#if hitPoints.max}}
        <div class="resource-container">

          <div class="resource-header" data-action="modifyResource" data-actor-uuid="{{actorUuid}}" data-resource="hitPoints.value"
            data-amount="1">
            <i class="fa-solid fa-heart-crack"></i>
          </div>

          <div class="resource-bar">
            {{#times hitPoints.max}}
            <div
              class="resource-pip pip-hitpoints {{#if (gte ../hitPoints.value (add this 1))}}filled{{else}}empty{{/if}}"
              data-action="toggleHitPoints" data-actor-uuid="{{../actorUuid}}" data-value="{{add this 1}}">
            </div>
            {{/times}}
          </div>

          <div class="resource-header" data-action="modifyResource" data-actor-uuid="{{actorUuid}}" data-resource="hitPoints.value"
            data-amount="1">
            <span class="resource-number">{{hitPoints.value}} / {{hitPoints.max}}</span>
          </div>

        </div>
        {{/if}}

        {{!-- STRESS --}}
        {{#if stress.max}}
        <div class="resource-container">

          <div class="resource-header" data-action="modifyResource" data-actor-uuid="{{actorUuid}}" data-resource="stress.value"
            data-amount="1">
            <i class="fa-solid fa-bolt"></i>
          </div>

          <div class="resource-bar">
              {{#times stress.max}}
              <div class="resource-pip pip-stress {{#if (gte ../stress.value (add this 1))}}filled{{else}}empty{{/if}}"
                data-action="toggleStress" data-actor-uuid="{{../actorUuid}}" data-value="{{add this 1}}">
              </div>
              {{/times}}
          </div>

          <div class="resource-header" data-action="modifyResource" data-actor-uuid="{{actorUuid}}" data-resource="stress.value"
            data-amount="1">
            <span class="resource-number">{{stress.value}} /
              {{stress.max}}</span>
          </div>

        </div>
        {{/if}}

        {{!-- ARMOR --}}
        {{#if armorSlots.max}}
        <div class="resource-container">

          <div class="resource-header" data-action="modifyResource" data-actor-uuid="{{actorUuid}}" data-resource="system.armorScore.value"
            data-amount="1">
            <i class="fa-solid fa-shield"></i>
          </div>

          <div class="resource-bar">
              {{#times armorSlots.max}}
              <div class="resource-pip pip-armor {{#if (gte ../armorSlots.value (add this 1))}}filled{{else}}empty{{/if}}"
                data-action="toggleArmorSlot"
                {{#if ../armorSlots.itemUuid}}data-item-uuid="{{../armorSlots.itemUuid}}"{{else}}data-actor-uuid="{{../actorUuid}}"{{/if}}
                data-value="{{add this 1}}">
              </div>
              {{/times}}
            </div>

          <div class="resource-header" data-action="modifyResource" data-actor-uuid="{{actorUuid}}" data-resource="system.armorScore.value"
            data-amount="1">
            <span class="resource-number">{{armorSlots.value}} /
              {{armorSlots.max}}</span>
          </div>

        </div>
        {{/if}}

      </div>

      {{!-- TRAITS --}}
      <div class="traits-row">
        {{#each attributes as |attribute key|}}
        <div
          class="trait-container {{#if attribute.isSpellcasting}}spellcast-trait{{/if}}"
          data-attribute="{{key}}"
          data-value="{{attribute.value}}">
          <span class="trait-name">{{localize (concat 'DAGGERHEART.CONFIG.Traits.' key '.short')}}</span>
          <span class="trait-number">
            {{#if (gt attribute.value 0)}}
            <span>+{{attribute.value}}</span>
            {{else}}
            <span>{{attribute.value}}</span>
            {{/if}}
          </span>
        </div>
        {{/each}}
      </div>

    </div>
    {{/if}}

  </div>

  {{#if @root.editable}}
  <div class="party-character-remove" data-action="deletePartyMember" data-actor-uuid="{{actorUuid}}"
    data-tooltip="{{localize 'DAGGERHEART.ACTORS.Party.RemoveConfirmation.title' name=actor.name}}">
    <div class="party-character-remove-icon">
      <i class="fa-solid fa-x"></i>
    </div>
  </div>
  {{/if}}

</div>